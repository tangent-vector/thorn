  "name": "thorn-agent",
  "agent_class": "ProjectCoordinator",
  "metadata": {
    "project": "my-repo"
  },
  "accounts": [
    {
      "service": "github",
      "credentials": [
        {
          "kind": "pat",
          "env_var_name": "GITHUB_TOKEN"
