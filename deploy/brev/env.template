# Thorn secret environment variables -- copy this template to a private path
# outside every Git checkout and fill in the required values.
#
# Thorn reads only **secrets** from environment variables.  All other
# configuration (forge base URL, project metadata, polling cadence,
# event-source settings) lives in `.thorn/gateway.json` and the
# per-agent identity JSON files written by `thorn serve bootstrap`.
#
# The deployment helper copies an explicitly selected file to
# /home/ubuntu/workspace/.config/thorn/secrets.env with mode 0600. Thorn reads
# it only when launched with the matching `--env-file` argument.

# ---------------------------------------------------------------------------
# LLM provider (required)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible API endpoint.
OPENAI_API_URL=
OPENAI_API_KEY=
OPENAI_API_MODEL_NAME=

# Optional: override the default max_tokens sent to the model.
# OPENAI_MAX_TOKENS=

# ---------------------------------------------------------------------------
# Forge access tokens (set whichever forge(s) you use)
# ---------------------------------------------------------------------------
# These are the only forge values read from the environment.  The agent
# identity JSON written by `thorn serve bootstrap` references them as
# `$GITHUB_TOKEN` / `$GITLAB_TOKEN` by default.  To use a different env
# var name, pass `--token-env MY_VAR_NAME` to bootstrap (or edit
# the agent JSON directly).

# Bot user PAT with scopes: repo, notifications, read:org (if needed).
GITHUB_TOKEN=

# GitLab PAT with API scope.
# GITLAB_TOKEN=

# ---------------------------------------------------------------------------
# Credential broker
# ---------------------------------------------------------------------------
# In the default ("just run thorn serve") shape, the gateway brings up
# its own per-process OneCLI broker on startup, mints the admin API
# key in process memory, and tears the stack down on shutdown.  None
# of the variables below need to be set for that path.
#
# The variables in this section are only consumed when:
#
# * You run an external (operator-managed) broker and configure
#   gateway.json with `"broker": { "mode": "external", ... }`.  In
#   that case, set ONECLI_ADMIN_KEY (or whatever env var name you
#   prefer) to the admin API key for that broker and reference it
#   from gateway.json via `"admin_api_key_env_var": "ONECLI_ADMIN_KEY"`.
#   The value lives only in the environment; gateway.json never
#   carries the literal secret.
#
# * You extract `src/thorn/gateway/_resources/broker.compose.yml`
#   and run it yourself outside of `thorn serve` (the
#   "external broker" supported shape).  In that case the bind
#   host / Postgres / NextAuth-secret variables here parameterize
#   the bundled compose file.

# The OneCLI admin API key (Bearer token, prefix `oc_`).  Only needed
# for the external-broker shape; the bundled supervisor mints its own
# in process memory.
# ONECLI_ADMIN_KEY=

# Bind host for OneCLI's published ports (dashboard 10254, proxy 10255).
# Default 127.0.0.1 keeps the dashboard off the public network; set to
# 0.0.0.0 only if you've put the host behind separate auth.  Only
# consumed when you run the bundled compose yourself; the in-process
# bundled supervisor pins this to 127.0.0.1.
# ONECLI_BIND_HOST=127.0.0.1

# Postgres credentials for the bundled OneCLI database when you run
# the bundled compose yourself.  The in-process bundled supervisor
# ignores ONECLI_POSTGRES_PASSWORD from the host and injects a random
# per-stack password.
# ONECLI_POSTGRES_USER=onecli
# ONECLI_POSTGRES_PASSWORD=onecli
# ONECLI_POSTGRES_DB=onecli

# NextAuth session-signing secret for the OneCLI dashboard.  OneCLI
# computes its internal AUTH_MODE ("cloud" | "oauth" | "local") from
# this variable: leave it UNSET to keep OneCLI in its single-user
# "local" mode (which is what the bundled supervisor relies on).
# Generate with `openssl rand -hex 32` only when standing up a
# multi-user / multi-tenant broker.
# ONECLI_NEXTAUTH_SECRET=
