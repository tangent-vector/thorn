# Thorn environment variables -- copy to .env and fill in values.
#
# Place the completed file at the root of the thorn repo on the Brev
# instance (i.e. /home/ubuntu/workspace/thorn/.env).  Alternatively,
# use "brev secret create VAR_NAME" to inject these as instance-level
# environment variables.

# ---------------------------------------------------------------------------
# LLM provider (required)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible API endpoint.
OPENAI_API_URL=
OPENAI_API_KEY=
OPENAI_API_MODEL_NAME=

# Optional: override the default max_tokens sent to the model.
# OPENAI_MAX_TOKENS=

# ---------------------------------------------------------------------------
# GitHub (required for GitHub-based deployments)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# Optional: override the GitHub API base URL (defaults to https://api.github.com).
# GITHUB_URL=

# ---------------------------------------------------------------------------
# GitLab (required only if using a GitLab event source)
# ---------------------------------------------------------------------------
# GITLAB_URL=
# GITLAB_TOKEN=
