# Thorn environment variables -- copy to .env and fill in values.
#
# On Brev, prefer: one `brev secret create VAR_NAME` per variable below — no
# .env file is required on the instance. See deploy/brev/README.md.
#
# If you use a file instead, place it at the repo root on the instance
# (e.g. /home/ubuntu/workspace/thorn/.env).

# ---------------------------------------------------------------------------
# LLM provider (required)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible API endpoint.
OPENAI_API_URL=
OPENAI_API_KEY=
OPENAI_API_MODEL_NAME=

# Optional: override the default max_tokens sent to the model.
# OPENAI_MAX_TOKENS=

# ---------------------------------------------------------------------------
# GitHub (required for GitHub-based deployments)
# ---------------------------------------------------------------------------
# GitHub App installation auth (preferred for the gateway). PyGithub mints
# JWT and installation access tokens from these.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# Either inline PEM (use \\n for newlines in a single line) or a path:
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=

# Optional: PAT-only / local dev (omit GITHUB_APP_* when using this).
# GITHUB_TOKEN=

# Repository to monitor for notifications (owner/repo format).
# Required when using the GitHub event source.
# THORN_GITHUB_REPOSITORY=

# Optional: override the GitHub API base URL (defaults to https://api.github.com).
# GITHUB_URL=

# Optional: GitHub App slug for @-mention identity.
# THORN_GITHUB_APP_SLUG=

# ---------------------------------------------------------------------------
# GitLab (required only if using a GitLab event source)
# ---------------------------------------------------------------------------
# GITLAB_URL=
# GITLAB_TOKEN=
# THORN_GITLAB_USERNAME=

# ---------------------------------------------------------------------------
# Polling interval (applies to both GitHub and GitLab event sources)
# ---------------------------------------------------------------------------
# THORN_POLL_INTERVAL=30
