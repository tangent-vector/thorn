# Thorn environment variables -- copy to .env and fill in values.
#
# Thorn reads only **secrets** from environment variables.  All other
# configuration (forge base URL, project metadata, polling cadence,
# event-source settings) lives in `.thorn/gateway.json` and the
# per-agent identity JSON files written by `thorn serve bootstrap`.
#
# On Brev, prefer: one `brev secret create VAR_NAME` per variable below — no
# .env file is required on the instance. See deploy/brev/README.md.
#
# If you use a file instead, place it at the repo root on the instance
# (e.g. /home/ubuntu/workspace/thorn/.env).

# ---------------------------------------------------------------------------
# LLM provider (required)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible API endpoint.
OPENAI_API_URL=
OPENAI_API_KEY=
OPENAI_API_MODEL_NAME=

# Optional: override the default max_tokens sent to the model.
# OPENAI_MAX_TOKENS=

# ---------------------------------------------------------------------------
# Forge access tokens (set whichever forge(s) you use)
# ---------------------------------------------------------------------------
# These are the only forge values read from the environment.  The agent
# identity JSON written by `thorn serve bootstrap` references them as
# `$GITHUB_TOKEN` / `$GITLAB_TOKEN` by default.  To use a different env
# var name, pass `--access-token-env MY_VAR_NAME` to bootstrap (or edit
# the agent JSON directly).

# Bot user PAT with scopes: repo, notifications, read:org (if needed).
GITHUB_TOKEN=

# GitLab PAT with API scope.
# GITLAB_TOKEN=

# ---------------------------------------------------------------------------
# Credential broker (Phase D, optional)
# ---------------------------------------------------------------------------
# Set when running `docker compose -f deploy/broker.compose.yml up` (or
# the all-in-container variant) and when the gateway.json `broker`
# block is configured.  See `BrokerConfig` in
# src/thorn/gateway/_config.py for the full block shape, and the
# README's "Deployment modes" section for end-to-end setup.
#
# Note: the broker's MITM CA certificate is fetched and cached by the
# gateway at startup (via OneCLI's GET /api/gateway/ca); no shared
# Docker volume needs to be configured for it.

# The OneCLI admin API key (Bearer token, prefix `oc_`).  Mint via the
# OneCLI dashboard's API-key page and reference from gateway.json as
# `"admin_api_key": "$ONECLI_ADMIN_KEY"`.
# ONECLI_ADMIN_KEY=

# Bind host for OneCLI's local-only ports (dashboard 10254, proxy 10255).
# Default 127.0.0.1 keeps the dashboard off the public network; set to
# 0.0.0.0 only if you've put the host behind separate auth.
# ONECLI_BIND_HOST=127.0.0.1

# Postgres credentials for the bundled OneCLI database.  Defaults are
# used by the bundled compose if these are unset.
# ONECLI_POSTGRES_USER=onecli
# ONECLI_POSTGRES_PASSWORD=onecli
# ONECLI_POSTGRES_DB=onecli

# NextAuth session-signing secret for the OneCLI dashboard.  Required
# when AUTH_MODE is unset on OneCLI (oauth default); ignored under
# AUTH_MODE=local.  Generate with `openssl rand -hex 32`.
# ONECLI_NEXTAUTH_SECRET=
